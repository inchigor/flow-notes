{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow Notes",
  "version": "1.0.0",
  "identifier": "com.flownotes.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Flow Notes",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active"
        }
      },
      {
        "label": "quick-capture",
        "title": "Quick Capture",
        "url": "quick-capture.html",
        "width": 520,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "focus": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 14
        }
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "settings.html",
        "width": 500,
        "height": 450,
        "resizable": false,
        "visible": false,
        "center": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
